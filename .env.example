# Copy to .env.local (Next.js convention) and adjust if the backend runs elsewhere.
# Used both server-side (during SSR/ISR fetches) and client-side (browser auth calls),
# so it must be a NEXT_PUBLIC_ var to be readable in the browser bundle.
# In Vercel: set this in Project Settings → Environment Variables to your
# deployed TripNest_Backend URL (e.g. https://tripnest-backend.vercel.app) —
# .env.example/.env.local are never read by Vercel's build.
NEXT_PUBLIC_API_URL=http://localhost:5001

# Geoapify (https://www.geoapify.com/) — powers destination/attraction
# autosuggest (app/api/autosuggest) and the live Attractions tab
# (app/api/attractions). Deliberately NOT prefixed NEXT_PUBLIC_ — it's only
# ever read server-side (lib/geoapify.ts), the browser talks to our own
# /api/autosuggest and /api/attractions routes instead. Free tier: https://myprojects.geoapify.com/
# Also set this in Vercel's Project Settings → Environment Variables.
GEOAPIFY_API_KEY="replace-with-your-geoapify-api-key"

# Pixabay (https://pixabay.com/api/docs/) — powers real destination/
# activity photos (lib/pixabay.ts), replacing the hardcoded imageUrl
# fields in data/natGeoDestinations.ts, data/worldDestinations.ts, and
# data/activityHighlights.ts (kept only as a fallback for now — see those
# files). Free key: sign up at pixabay.com, then copy it from the API docs
# page. Also server-only, same reasoning as GEOAPIFY_API_KEY above, and
# also needs setting in Vercel's Project Settings → Environment Variables.
# Limits: 100 requests / 60s per key; responses must be cached 24h (done).
PIXABAY_API_KEY="replace-with-your-pixabay-api-key"
PIXABAY_API_URL=https://pixabay.com/api/
