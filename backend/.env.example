# Copy to .env and fill in real values. Never commit .env.
# 5001 (not 5000) is the default — 5000 is often already taken on macOS by
# the AirPlay Receiver service. Change it here if you need a different port,
# and update frontend/.env.local's NEXT_PUBLIC_API_URL to match.
PORT=5001

# A hosted Postgres connection string — e.g. Neon (https://neon.tech, free
# tier). Prefer the DIRECT (non "-pooler") connection string over a
# PgBouncer-pooled one — Prisma's migration engine can be finicky over
# pooled connections, and pooling isn't worth the complexity for local dev.
DATABASE_URL="postgresql://user:password@ep-example-123456.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# Generate real secrets with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"

ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7

CORS_ORIGIN="http://localhost:3000"
