# Copy to .env and fill in real values. Never commit .env.
PORT=5000

# Option A — matches docker-compose.yml at the project root (requires
# Docker Desktop installed and running):
DATABASE_URL="postgresql://tripnest:tripnest@localhost:5432/tripnest?schema=public"

# Option B — a hosted Postgres (e.g. Neon: https://neon.tech) instead of
# Docker/local Postgres. If using Neon, prefer its DIRECT (non "-pooler")
# connection string here — Prisma's migration engine can be finicky over
# pooled/PgBouncer connections, and pooling isn't worth the complexity for
# local dev anyway:
# DATABASE_URL="postgresql://user:password@ep-example-123456.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# Generate real secrets with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"

ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7

CORS_ORIGIN="http://localhost:3000"
