// TripNest backend schema.
// Users + auth, Listings, and now Reviews (with per-listing rating
// aggregation — see reviews.service.ts:recomputeListingRating). Booking,
// Wishlist etc. land in later phases per README.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TRAVELER
  OWNER
  ADMIN
}

// Coarse geographic region for the continent map (see
// frontend/src/components/ContinentMap.tsx) — a lightweight click-to-filter
// selector, not real lat/lng geo data. "Australia" in the UI maps to
// OCEANIA here, matching the standard 6-continent model.
enum Continent {
  NORTH_AMERICA
  SOUTH_AMERICA
  EUROPE
  AFRICA
  ASIA
  OCEANIA
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  role          Role           @default(TRAVELER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  reviews       Review[]

  @@map("users")
}

// Refresh tokens are stored hashed (never the raw token) so a leaked DB
// doesn't hand out usable tokens. Each row can be individually revoked,
// which is why we don't just rely on JWT expiry alone.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Listing {
  id            String    @id @default(uuid())
  title         String
  description   String?
  location      String
  continent     Continent @default(EUROPE)
  price         Float
  // Both fields below are derived from Review rows, recomputed by
  // reviews.service.ts:recomputeListingRating() on every review
  // create/update/delete — never written to directly elsewhere.
  averageRating Float     @default(0)
  reviewCount   Int       @default(0)
  imageUrl      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  reviews       Review[]

  @@index([continent])
  @@map("listings")
}

model Review {
  id          String        @id @default(uuid())
  listingId   String
  listing     Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating      Int // overall rating, 1-5
  cleanliness Int? // sub-ratings, 1-5 each, all optional
  service     Int?
  value       Int?
  location    Int?
  title       String
  body        String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  photos      ReviewPhoto[]

  // One review per user per listing — mirrors how TripAdvisor and similar
  // platforms constrain reviews; also makes "have I reviewed this?" a
  // simple lookup on the frontend.
  @@unique([listingId, userId])
  @@index([listingId])
  @@map("reviews")
}

// Photo URLs only for now — no upload/storage pipeline exists yet (see
// README.md, Platform concerns: "Image storage/CDN for uploads"). Callers
// must supply already-hosted URLs until S3/Cloudinary is wired up.
model ReviewPhoto {
  id        String   @id @default(uuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())

  @@map("review_photos")
}
